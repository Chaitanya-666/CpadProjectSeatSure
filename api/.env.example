# Copy to .env for local runs. Never commit .env.
PORT=3000
DATABASE_URL=postgres://seatsure:seatsure_local@127.0.0.1:5432/seatsure_dev
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
APP_TIMEZONE=Asia/Kolkata
# Demo tip: CHECKIN_GRACE_MINUTES=1 shows a no-show release live in a minute.
CHECKIN_GRACE_MINUTES=15
